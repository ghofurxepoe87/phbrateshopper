            <span class="block text-[7px] font-bold tracking-widest text-slate-500">BALIKPAPAN</span>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-base sm:text-lg font-bold tracking-tight text-white">BPN 4★ Live Rate Shopper</h1>
          <span class="px-2 py-0.5 text-[10px] font-bold uppercase rounded-full bg-white/20 text-white">
            FBM / REV
          </span>
          <span id="modeBadge" class="flex items-center gap-1 px-2.5 py-0.5 text-[11px] font-semibold rounded-full bg-emerald-500 text-white shadow-sm">
            <i data-lucide="cloud-check" class="w-3 h-3"></i>
            <span id="modeBadgeText">Local Ready</span>
          </span>
        </div>
      </div>

      <!-- Right: Action Buttons (Amber, White, Teal/Blue) -->
      <div class="flex flex-wrap items-center gap-2">
        <button onclick="openConfigModal()" class="flex items-center gap-1.5 bg-phb-amber hover:bg-amber-400 text-slate-900 text-xs font-bold px-3.5 py-2 rounded-xl shadow-sm transition">
          <i data-lucide="plug" class="w-3.5 h-3.5"></i>
          <span>API & Panduan</span>
        </button>

        <button onclick="fetchLiveRates()" class="flex items-center gap-1.5 bg-white hover:bg-slate-50 text-phb-blue text-xs font-bold px-3.5 py-2 rounded-xl shadow-sm transition">
          <i data-lucide="refresh-cw" id="spinIcon" class="w-3.5 h-3.5"></i>
          <span>Cek OTA Sekarang</span>
